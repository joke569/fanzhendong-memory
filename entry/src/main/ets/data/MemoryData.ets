export function getMemories(line?: MemoryLine): MemoryItem[] {
  if (line === undefined) { return MEMORIES; }
  return MEMORIES.filter((item: MemoryItem) => item.line === line);
}

export function getMemoryById(id: string): MemoryItem | undefined {
  return MEMORIES.find((item: MemoryItem) => item.id === id);
}